---
import { cvData } from '../data/cvData';
const { researchInterests } = cvData;
---

<section id="research" class="py-14 sm:py-20 bg-slate-100/50 border-b border-slate-200/80 dark:bg-academic-navy-950/40 dark:border-slate-800/80">
  <div class="mx-auto max-w-academic px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-academic-navy-900 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n-en="Core Research Pillars" data-i18n-ar="الاهتمامات والمحاور البحثية">
          Core Research Pillars
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400" data-i18n-en="Theoretical lenses, empirical focus, and socio-technical investigation streams" data-i18n-ar="المقاربات النظرية ومسارات البحث التجريبي والاجتماعي-التقني">
          Theoretical lenses, empirical focus, and socio-technical investigation streams
        </p>
      </div>
    </div>

    <!-- Research Cards Grid -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {researchInterests.map((item) => (
        <div class="group relative flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition hover:border-academic-navy-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-slate-700">
          <div>
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-academic-navy-50 text-academic-navy-800 transition group-hover:bg-academic-navy-900 group-hover:text-white dark:bg-slate-800 dark:text-academic-gold-400 dark:group-hover:bg-academic-gold-500 dark:group-hover:text-slate-950">
                {item.icon === 'brain' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {item.icon === 'network' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                )}
                {item.icon === 'activity' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                )}
              </div>

              <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white" data-i18n-en={item.title.en} data-i18n-ar={item.title.ar}>
                {item.title.en}
              </h3>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300" data-i18n-en={item.description.en} data-i18n-ar={item.description.ar}>
              {item.description.en}
            </p>
          </div>

          <!-- Keywords Tags -->
          <div class="mt-5 flex flex-wrap gap-1.5 pt-4 border-t border-slate-100 dark:border-slate-800/80">
            {item.keywords.en.map((kw, i) => (
              <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">
                <span data-i18n-en={kw} data-i18n-ar={item.keywords.ar[i] || kw}>{kw}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
