---
import { cvData } from '../data/cvData';
const { personal, education, positions } = cvData;
---

<section id="about" class="py-14 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="mx-auto max-w-academic px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-academic-navy-900 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n-en="Academic Biography & Overview" data-i18n-ar="السيرة الأكاديمية ونبذة عامة">
          Academic Biography & Overview
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400" data-i18n-en="Career trajectory, research philosophy, and formal academic appointments" data-i18n-ar="المسيرة الأكاديمية، والفلسفة البحثية، والمناصب الرسمية">
          Career trajectory, research philosophy, and formal academic appointments
        </p>
      </div>
    </div>

    <!-- Main Narrative & Research Philosophy -->
    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Bio Text -->
      <div class="lg:col-span-7 space-y-4 text-base leading-relaxed text-slate-700 dark:text-slate-300">
        <p data-i18n-en={personal.bio.en} data-i18n-ar={personal.bio.ar}>
          {personal.bio.en}
        </p>
        
        <!-- Philosophy Callout Box -->
        <div class="mt-6 rounded-xl border border-academic-navy-100 bg-academic-navy-50/50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
          <div class="flex items-start gap-3">
            <span class="text-2xl text-academic-gold-500 font-serif">“</span>
            <div>
              <h3 class="font-serif text-sm font-semibold uppercase tracking-wider text-academic-navy-900 dark:text-academic-gold-400" data-i18n-en="Research Philosophy & Methodological Paradigm" data-i18n-ar="فلسفة البحث العلمي والنموذج المنهجي">
                Research Philosophy & Methodological Paradigm
              </h3>
              <p class="mt-1 text-sm italic text-slate-700 dark:text-slate-300" data-i18n-en={personal.researchPhilosophy.en} data-i18n-ar={personal.researchPhilosophy.ar}>
                {personal.researchPhilosophy.en}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Facts / Institutional Card -->
      <div class="lg:col-span-5 flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-academic-navy-900/40">
        <div>
          <h3 class="font-serif text-base font-bold text-slate-900 dark:text-white" data-i18n-en="Faculty Information" data-i18n-ar="بيانات الهيئة التعليمية">
            Faculty Information
          </h3>
          <dl class="mt-4 divide-y divide-slate-100 text-xs sm:text-sm dark:divide-slate-800">
            <div class="py-2.5 flex justify-between gap-2">
              <dt class="font-medium text-slate-500 dark:text-slate-400" data-i18n-en="Primary Rank" data-i18n-ar="الرتبة الأكاديمية">Primary Rank</dt>
              <dd class="font-semibold text-slate-800 dark:text-slate-200" data-i18n-en="Full Professor (Tenured)" data-i18n-ar="أستاذ دكتور (مثبّت)">Full Professor (Tenured)</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-2">
              <dt class="font-medium text-slate-500 dark:text-slate-400" data-i18n-en="Research Group" data-i18n-ar="المجموعة البحثية">Research Group</dt>
              <dd class="font-semibold text-slate-800 dark:text-slate-200" data-i18n-en="Enterprise AI & Platforms Lab" data-i18n-ar="مختبر الذكاء الاصطناعي المؤسسي">Enterprise AI & Platforms Lab</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-2">
              <dt class="font-medium text-slate-500 dark:text-slate-400" data-i18n-en="Affiliation" data-i18n-ar="الجهة الأكاديمية">Affiliation</dt>
              <dd class="font-semibold text-slate-800 text-right dark:text-slate-200" data-i18n-en={personal.institution.en} data-i18n-ar={personal.institution.ar}>{personal.institution.en}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-2">
              <dt class="font-medium text-slate-500 dark:text-slate-400" data-i18n-en="Discipline" data-i18n-ar="التخصص العلمي">Discipline</dt>
              <dd class="font-semibold text-slate-800 dark:text-slate-200" data-i18n-en="Information Systems (IS)" data-i18n-ar="نظم المعلومات (IS)">Information Systems (IS)</dd>
            </div>
          </dl>
        </div>

        <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
          <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <svg class="h-4 w-4 text-academic-gold-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span data-i18n-en="Verified Senior AIS Academic Scholar" data-i18n-ar="أكاديمي معتمد لدى جمعية نظم المعلومات العالمية">Verified Senior AIS Academic Scholar</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Academic Positions & Education Split Grid -->
    <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-2">
      
      <!-- Academic Appointments Timeline -->
      <div>
        <h3 class="flex items-center gap-2 font-serif text-xl font-bold text-slate-900 dark:text-white">
          <svg class="h-5 w-5 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span data-i18n-en="Academic Positions & Appointments" data-i18n-ar="الخبرات والمناصب الأكاديمية">Academic Positions & Appointments</span>
        </h3>

        <div class="mt-6 relative border-l-2 border-slate-200 pl-6 dark:border-slate-800 rtl:border-l-0 rtl:border-r-2 rtl:pl-0 rtl:pr-6 space-y-8">
          {positions.map((pos) => (
            <div class="relative group">
              <!-- Timeline Dot -->
              <div class="absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-academic-navy-800 group-hover:scale-125 transition-transform dark:border-slate-900 dark:bg-academic-gold-400 rtl:-left-auto rtl:-right-[31px]"></div>
              
              <div class="flex flex-wrap items-baseline justify-between gap-1">
                <h4 class="font-serif text-base font-bold text-slate-900 dark:text-white" data-i18n-en={pos.role.en} data-i18n-ar={pos.role.ar}>
                  {pos.role.en}
                </h4>
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                  {pos.period}
                </span>
              </div>

              <p class="mt-1 text-sm font-medium text-academic-navy-700 dark:text-academic-gold-400" data-i18n-en={pos.institution.en} data-i18n-ar={pos.institution.ar}>
                {pos.institution.en}
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400" data-i18n-en={pos.department.en} data-i18n-ar={pos.department.ar}>
                {pos.department.en}
              </p>

              {pos.highlights && (
                <ul class="mt-2 space-y-1 text-xs text-slate-600 dark:text-slate-300">
                  {pos.highlights.en.map((hl, i) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-academic-gold-500 font-bold">•</span>
                      <span data-i18n-en={hl} data-i18n-ar={pos.highlights?.ar[i] || hl}>{hl}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Higher Education & Degrees -->
      <div>
        <h3 class="flex items-center gap-2 font-serif text-xl font-bold text-slate-900 dark:text-white">
          <svg class="h-5 w-5 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
          <span data-i18n-en="Higher Education & Degrees" data-i18n-ar="الدرجات العلمية والمؤهلات">Higher Education & Degrees</span>
        </h3>

        <div class="mt-6 space-y-6">
          {education.map((edu) => (
            <div class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/40">
              <div class="flex flex-wrap items-baseline justify-between gap-1">
                <h4 class="font-serif text-base font-bold text-slate-900 dark:text-white" data-i18n-en={edu.degree.en} data-i18n-ar={edu.degree.ar}>
                  {edu.degree.en}
                </h4>
                <span class="rounded bg-academic-navy-50 px-2 py-0.5 text-xs font-semibold text-academic-navy-800 dark:bg-academic-navy-950 dark:text-academic-gold-400">
                  {edu.year}
                </span>
              </div>

              <p class="mt-1 text-sm font-medium text-slate-700 dark:text-slate-300" data-i18n-en={`${edu.institution.en} — ${edu.location.en}`} data-i18n-ar={`${edu.institution.ar} — ${edu.location.ar}`}>
                {edu.institution.en} — {edu.location.en}
              </p>

              {edu.honors && (
                <div class="mt-2 inline-block rounded border border-academic-gold-200 bg-academic-gold-50 px-2 py-0.5 text-xs font-semibold text-academic-gold-800 dark:border-academic-gold-900/50 dark:bg-academic-gold-950/40 dark:text-academic-gold-300">
                  <span data-i18n-en={edu.honors.en} data-i18n-ar={edu.honors.ar}>{edu.honors.en}</span>
                </div>
              )}

              {edu.dissertation && (
                <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                  <strong class="text-slate-700 dark:text-slate-300" data-i18n-en="Dissertation: " data-i18n-ar="عنوان الأطروحة: ">Dissertation: </strong>
                  <span class="italic" data-i18n-en={`"${edu.dissertation.en}"`} data-i18n-ar={`"${edu.dissertation.ar}"`}>"{edu.dissertation.en}"</span>
                  {edu.advisor && (
                    <span class="block mt-0.5 text-slate-500" data-i18n-en={`(${edu.advisor.en})`} data-i18n-ar={`(${edu.advisor.ar})`}>
                      ({edu.advisor.en})
                    </span>
                  )}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
