---
import { graduationProjects } from '../data/projects';
import { uiTranslations } from '../data/translations';

const t = uiTranslations.projects;
---

<section id="projects" class="py-16 sm:py-20 border-b border-slate-200/80 bg-slate-50/60 dark:border-slate-800/80 dark:bg-slate-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-slate-800 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          <span class="lang-en">{t.sectionTitle.en}</span>
          <span class="lang-ar">{t.sectionTitle.ar}</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          <span class="lang-en">{t.sectionSubtitle.en}</span>
          <span class="lang-ar">{t.sectionSubtitle.ar}</span>
        </p>
      </div>
    </div>

    <!-- Projects Grid (6 Verified CV Projects) -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {graduationProjects.map((proj) => (
        <div class={`flex flex-col justify-between rounded-2xl border p-6 shadow-sm transition hover:shadow-md ${proj.award ? 'border-amber-300/80 bg-gradient-to-br from-amber-50/40 via-white to-white dark:border-amber-900/60 dark:from-slate-900 dark:to-slate-900/60' : 'border-slate-200/90 bg-white dark:border-slate-800 dark:bg-slate-900/60'}`}>
          <div>
            <!-- Header: Year and Award Badge -->
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span class="rounded bg-academic-navy-900 px-2 py-0.5 font-mono text-xs font-bold text-white dark:bg-slate-800 dark:text-academic-gold-400">
                {proj.year}
              </span>

              {proj.award && (
                <span class="inline-flex items-center gap-1 rounded bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-900 dark:bg-amber-950/80 dark:text-amber-300">
                  <svg class="h-3.5 w-3.5 text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <span class="lang-en">Silver Medal Award</span>
                  <span class="lang-ar">حائز على الميدالية الفضية</span>
                </span>
              )}
            </div>

            <h3 class="font-serif text-base font-bold text-slate-900 dark:text-white leading-snug">
              <span class="lang-en">{proj.title.en}</span>
              <span class="lang-ar">{proj.title.ar || proj.title.en}</span>
            </h3>

            <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              <span class="lang-en">{proj.description.en}</span>
              <span class="lang-ar">{proj.description.ar || proj.description.en}</span>
            </p>

            {proj.award && (
              <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50/70 p-2.5 text-xs font-semibold text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/40 dark:text-amber-200">
                🏆 <span class="lang-en">{proj.award.en}</span><span class="lang-ar">{proj.award.ar || proj.award.en}</span>
              </div>
            )}
          </div>

          <!-- Technologies Tags -->
          <div class="mt-5 pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-1">
            {proj.technologies.map((tech) => (
              <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
