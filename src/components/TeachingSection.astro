---
import { teachingCourses } from '../data/teaching';
import { uiTranslations } from '../data/translations';

const mscCourses = teachingCourses.filter(c => c.level === 'Postgraduate (M.Sc.)');
const bscCourses = teachingCourses.filter(c => c.level === 'Undergraduate (B.Sc.)');
const t = uiTranslations.teaching;
---

<section id="teaching" class="py-16 sm:py-20 border-b border-slate-200/80 bg-slate-50/60 dark:border-slate-800/80 dark:bg-slate-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-slate-800 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          <span class="lang-en">{t.sectionTitle.en}</span>
          <span class="lang-ar">{t.sectionTitle.ar}</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          <span class="lang-en">{t.sectionSubtitle.en}</span>
          <span class="lang-ar">{t.sectionSubtitle.ar}</span>
        </p>
      </div>
    </div>

    <!-- 1. Postgraduate Courses (M.Sc.) -->
    <div class="mt-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="rounded bg-academic-navy-900 px-2.5 py-1 text-xs font-bold text-white dark:bg-slate-800 dark:text-academic-gold-400">
          <span class="lang-en">{t.postgraduateTab.en}</span>
          <span class="lang-ar">{t.postgraduateTab.ar}</span>
        </span>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
          <span class="lang-en">Master of Science in Computer Science & Information Systems</span>
          <span class="lang-ar">ماجستير علوم الحاسوب ونظم المعلومات</span>
        </span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {mscCourses.map((course) => (
          <div class="group flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm transition hover:border-academic-navy-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-academic-navy-700 dark:text-academic-gold-400">
                  <span class="lang-en">{t.advancedCourse.en}</span>
                  <span class="lang-ar">{t.advancedCourse.ar}</span>
                </span>
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              </div>
              <h3 class="mt-2 font-serif text-base font-bold text-slate-900 dark:text-white leading-snug">
                <span class="lang-en">{course.title.en}</span>
                <span class="lang-ar">{course.title.ar || course.title.en}</span>
              </h3>
              {course.description && (
                <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                  <span class="lang-en">{course.description.en}</span>
                  <span class="lang-ar">{course.description.ar || course.description.en}</span>
                </p>
              )}
            </div>
            
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400">
              <span class="lang-en">{t.futureNotice.en}</span>
              <span class="lang-ar">{t.futureNotice.ar}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. Undergraduate Courses (B.Sc.) -->
    <div class="mt-14">
      <div class="flex items-center gap-2 mb-4">
        <span class="rounded bg-slate-200 px-2.5 py-1 text-xs font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-200">
          <span class="lang-en">{t.undergraduateTab.en}</span>
          <span class="lang-ar">{t.undergraduateTab.ar}</span>
        </span>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
          <span class="lang-en">Bachelor Degree Programs (18 Core & Specialized Courses)</span>
          <span class="lang-ar">برامج البكالوريوس (18 مقرراً تخصصياً وإجبارياً)</span>
        </span>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {bscCourses.map((course) => (
          <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/50">
            <div class="flex items-start justify-between gap-2">
              <h4 class="font-serif text-sm font-bold text-slate-900 dark:text-white leading-snug">
                <span class="lang-en">{course.title.en}</span>
                <span class="lang-ar">{course.title.ar || course.title.en}</span>
              </h4>
              <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400 shrink-0">
                <span class="lang-en">{course.category === 'core' ? t.coreCourse.en : course.category === 'advanced' ? t.advancedCourse.en : t.specializedCourse.en}</span>
                <span class="lang-ar">{course.category === 'core' ? t.coreCourse.ar : course.category === 'advanced' ? t.advancedCourse.ar : t.specializedCourse.ar}</span>
              </span>
            </div>
            {course.description && (
              <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                <span class="lang-en">{course.description.en}</span>
                <span class="lang-ar">{course.description.ar || course.description.en}</span>
              </p>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
