---
import { academicHighlights } from '../data/profile';
---

<section class="border-b border-slate-200/80 bg-white py-8 dark:border-slate-800/80 dark:bg-slate-900/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {academicHighlights.map((hl) => (
        <div class="flex flex-col items-center justify-center rounded-xl border border-slate-100 bg-slate-50/80 p-4 text-center transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/80">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-academic-navy-50 text-academic-navy-800 dark:bg-slate-800 dark:text-academic-gold-400">
            {hl.icon === 'user-check' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            )}
            {hl.icon === 'academic-cap' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            )}
            {hl.icon === 'document-text' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {hl.icon === 'badge-check' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            )}
            {hl.icon === 'clock' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
          </div>
          <span class="mt-2 font-serif text-sm font-bold text-slate-900 dark:text-white">
            <span class="lang-en">{hl.title.en}</span>
            <span class="lang-ar">{hl.title.ar || hl.title.en}</span>
          </span>
          <span class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
            <span class="lang-en">{hl.subtitle.en}</span>
            <span class="lang-ar">{hl.subtitle.ar || hl.subtitle.en}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
