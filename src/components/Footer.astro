---
import { personalProfile } from '../data/profile';
import { uiTranslations } from '../data/translations';

const name = personalProfile?.name || { en: 'Prof. Dr. Rasha Abdulaziz Bin-Thalab', ar: 'أ.د. رشا عبدالعزيز بن ثعلب' };
const title = personalProfile?.title || { en: 'Professor of Computer Science & Information Systems', ar: 'أستاذ علوم الحاسوب ونظم المعلومات' };
const department = personalProfile?.department || { en: 'Department of Computer Engineering', ar: 'قسم هندسة الحاسوب' };
const faculty = personalProfile?.faculty || { en: 'Faculty of Engineering & Petroleum', ar: 'كلية الهندسة والبترول' };
const institution = personalProfile?.institution || { en: 'Hadhramout University', ar: 'جامعة حضرموت' };
const links = personalProfile?.links || {
  scholar: 'https://scholar.google.com',
  orcid: 'https://orcid.org',
  researchGate: 'https://www.researchgate.net',
  semanticScholar: 'https://www.semanticscholar.org',
};
const t = uiTranslations.footer;
---

<footer class="border-t border-slate-200 bg-white py-12 text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400 no-print">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 lg:px-8 text-center sm:flex-row sm:text-left rtl:sm:text-right">
    
    <!-- Left / Identity -->
    <div class="space-y-1">
      <p class="font-serif text-sm font-bold text-slate-900 dark:text-white">
        <span class="lang-en">{name.en}</span>
        <span class="lang-ar">{name.ar || name.en}</span>
      </p>
      <p class="text-xs text-slate-600 dark:text-slate-400">
        <span class="lang-en">{title.en}</span>
        <span class="lang-ar">{title.ar || title.en}</span>
      </p>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        <span class="lang-en">{department.en}, {faculty.en} — {institution.en}</span>
        <span class="lang-ar">{department.ar || department.en}، {faculty.ar || faculty.en} — {institution.ar || institution.en}</span>
      </p>
      <p class="text-[11px] text-slate-400 pt-1">
        <span class="lang-en">© {new Date().getFullYear()} {name.en}. {t.rights.en}</span>
        <span class="lang-ar">© {new Date().getFullYear()} {name.ar || name.en}. {t.rights.ar}</span>
      </p>
    </div>

    <!-- Right / Quick Jump & Profiles -->
    <div class="flex flex-col items-center sm:items-end gap-3">
      <div class="flex items-center gap-3 text-xs">
        <a href={links.scholar} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition">Scholar</a>
        <span>•</span>
        <a href={links.orcid} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition">ORCID</a>
        <span>•</span>
        <a href={links.researchGate} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition">ResearchGate</a>
        <span>•</span>
        <a href={links.semanticScholar} target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition">Semantic Scholar</a>
      </div>

      <a
        href="#top"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        <span class="lang-en">{t.backToTop.en}</span>
        <span class="lang-ar">{t.backToTop.ar}</span>
      </a>
    </div>

  </div>
</footer>
