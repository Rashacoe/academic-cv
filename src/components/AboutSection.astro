---
import { personalProfile } from '../data/profile';
import { educationRecords } from '../data/education';
import { administrativeRoles } from '../data/positions';
import { uiTranslations } from '../data/translations';

const t = uiTranslations.about;
---

<section id="about" class="py-16 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-slate-800 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          <span class="lang-en">{t.sectionTitle.en}</span>
          <span class="lang-ar">{t.sectionTitle.ar}</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          <span class="lang-en">{t.sectionSubtitle.en}</span>
          <span class="lang-ar">{t.sectionSubtitle.ar}</span>
        </p>
      </div>
    </div>

    <!-- 2-Column Split: Education & Qualifications vs Academic Leadership Roles -->
    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12">
      
      <!-- Education Column (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex items-center gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
          <svg class="h-5 w-5 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
          <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
            <span class="lang-en">{t.educationTitle.en}</span>
            <span class="lang-ar">{t.educationTitle.ar}</span>
          </h3>
        </div>

        <div class="space-y-4">
          {educationRecords.map((edu) => (
            <div class="rounded-2xl border border-slate-200/90 bg-slate-50/70 p-5 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="flex items-baseline justify-between gap-2">
                <h4 class="font-serif text-base font-bold text-slate-900 dark:text-white">
                  <span class="lang-en">{edu.degree.en}</span>
                  <span class="lang-ar">{edu.degree.ar || edu.degree.en}</span>
                </h4>
                <span class="rounded bg-academic-navy-100 px-2 py-0.5 font-mono text-xs font-semibold text-academic-navy-800 dark:bg-slate-800 dark:text-academic-gold-400">
                  {edu.period}
                </span>
              </div>

              <p class="mt-1 font-medium text-xs sm:text-sm text-academic-navy-700 dark:text-slate-200">
                <span class="lang-en">{edu.field.en}</span>
                <span class="lang-ar">{edu.field.ar || edu.field.en}</span>
              </p>
              <p class="text-xs text-slate-600 dark:text-slate-400">
                <span class="lang-en">{edu.institution.en} — <span class="italic">{edu.location.en}</span></span>
                <span class="lang-ar">{edu.institution.ar || edu.institution.en} — <span class="italic">{edu.location.ar || edu.location.en}</span></span>
              </p>

              {edu.notes && (
                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  <span class="lang-en">{edu.notes.en}</span>
                  <span class="lang-ar">{edu.notes.ar || edu.notes.en}</span>
                </p>
              )}
            </div>
          ))}
        </div>

        <!-- Institutional Affiliation Note Box -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">
            <span class="lang-en">{t.primaryAffiliation.en}</span>
            <span class="lang-ar">{t.primaryAffiliation.ar}</span>
          </h4>
          <p class="mt-1 font-serif text-sm font-bold text-slate-900 dark:text-white">
            <span class="lang-en">{personalProfile.department.en}</span>
            <span class="lang-ar">{personalProfile.department.ar || personalProfile.department.en}</span>
          </p>
          <p class="text-xs text-slate-600 dark:text-slate-300">
            <span class="lang-en">{personalProfile.faculty.en}</span>
            <span class="lang-ar">{personalProfile.faculty.ar || personalProfile.faculty.en}</span>
          </p>
          <p class="text-xs font-semibold text-academic-navy-700 dark:text-academic-gold-400">
            <span class="lang-en">{personalProfile.institution.en}</span>
            <span class="lang-ar">{personalProfile.institution.ar || personalProfile.institution.en}</span>
          </p>
        </div>
      </div>

      <!-- Academic Leadership & Administrative Roles (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="flex items-center gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
          <svg class="h-5 w-5 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
            <span class="lang-en">{t.leadershipTitle.en}</span>
            <span class="lang-ar">{t.leadershipTitle.ar}</span>
          </h3>
        </div>

        <div class="relative border-l-2 border-slate-200 pl-6 dark:border-slate-800 rtl:border-l-0 rtl:border-r-2 rtl:pl-0 rtl:pr-6 space-y-5">
          {administrativeRoles.map((role) => (
            <div class="relative group">
              <!-- Timeline Dot -->
              <div class={`absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-white transition-transform group-hover:scale-125 dark:border-slate-950 rtl:-left-auto rtl:-right-[31px] ${role.isCurrent ? 'bg-academic-navy-800 dark:bg-academic-gold-400 ring-2 ring-academic-navy-200 dark:ring-academic-gold-900' : 'bg-slate-400 dark:bg-slate-600'}`}></div>

              <div class="flex flex-wrap items-baseline justify-between gap-1">
                <h4 class="font-serif text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                  <span class="lang-en">{role.role.en}</span>
                  <span class="lang-ar">{role.role.ar || role.role.en}</span>
                </h4>
                <span class={`rounded px-2 py-0.5 text-xs font-semibold ${role.isCurrent ? 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300'}`}>
                  {role.period === 'Current Appointment' ? (
                    <>
                      <span class="lang-en">{role.period}</span>
                      <span class="lang-ar">تعيين حالي</span>
                    </>
                  ) : role.period.includes('Present') ? (
                    <>
                      <span class="lang-en">{role.period}</span>
                      <span class="lang-ar">{role.period.replace('Present', 'حتى الآن').replace('March', 'مارس')}</span>
                    </>
                  ) : (
                    role.period
                  )}
                </span>
              </div>

              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 mt-1">
                <span class="lang-en">{role.unit.en}</span>
                <span class="lang-ar">{role.unit.ar || role.unit.en}</span>
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                <span class="lang-en">{role.institution.en}</span>
                <span class="lang-ar">{role.institution.ar || role.institution.en}</span>
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
