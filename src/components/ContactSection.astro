---
import { personalProfile } from '../data/profile';
import { uiTranslations } from '../data/translations';

const department = personalProfile?.department || { en: 'Department of Computer Engineering', ar: 'قسم هندسة الحاسوب' };
const faculty = personalProfile?.faculty || { en: 'Faculty of Engineering & Petroleum', ar: 'كلية الهندسة والبترول' };
const institution = personalProfile?.institution || { en: 'Hadhramout University', ar: 'جامعة حضرموت' };
const location = personalProfile?.location || { en: 'Mukalla, Hadhramout, Yemen', ar: 'المكلا، حضرموت، اليمن' };
const email = personalProfile?.email || 'r.binthalab@hu.edu.ye';
const phonePrimary = personalProfile?.phonePrimary || '+967 776384300';
const phoneSecondary = personalProfile?.phoneSecondary || '+967 739180011';
const links = personalProfile?.links || {
  scholar: 'https://scholar.google.com',
  orcid: 'https://orcid.org',
  researchGate: 'https://www.researchgate.net',
  semanticScholar: 'https://www.semanticscholar.org',
};
const t = uiTranslations.contact;
---

<section id="contact" class="py-16 sm:py-20 border-b border-slate-200/80 bg-white dark:border-slate-800/80 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-slate-800 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          <span class="lang-en">{t.sectionTitle.en}</span>
          <span class="lang-ar">{t.sectionTitle.ar}</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          <span class="lang-en">{t.sectionSubtitle.en}</span>
          <span class="lang-ar">{t.sectionSubtitle.ar}</span>
        </p>
      </div>
    </div>

    <!-- Contact Grid -->
    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12">
      
      <!-- Institutional Address & Channels (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <!-- Affiliation Card -->
        <div class="rounded-2xl border border-slate-200/90 bg-slate-50/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
          <h3 class="font-serif text-base font-bold text-slate-900 dark:text-white">
            <span class="lang-en">{t.campusLocation.en}</span>
            <span class="lang-ar">{t.campusLocation.ar}</span>
          </h3>
          <div class="mt-2 space-y-1 text-sm text-slate-700 dark:text-slate-300">
            <p class="font-semibold">
              <span class="lang-en">{department.en}</span>
              <span class="lang-ar">{department.ar || department.en}</span>
            </p>
            <p>
              <span class="lang-en">{faculty.en}</span>
              <span class="lang-ar">{faculty.ar || faculty.en}</span>
            </p>
            <p class="font-semibold text-academic-navy-700 dark:text-academic-gold-400">
              <span class="lang-en">{institution.en}</span>
              <span class="lang-ar">{institution.ar || institution.en}</span>
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              📍 <span class="lang-en">{location.en}</span><span class="lang-ar">{location.ar || location.en}</span>
            </p>
          </div>
        </div>

        <!-- Direct Email & Phone Channels -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Institutional Email -->
          <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
              <span class="lang-en">{t.officialEmail.en}</span>
              <span class="lang-ar">{t.officialEmail.ar}</span>
            </span>
            <a
              href={`mailto:${email}`}
              class="mt-1 block font-mono text-sm font-semibold text-academic-navy-700 hover:underline dark:text-academic-gold-400"
            >
              {email}
            </a>
          </div>

          <!-- Mobile / WhatsApp -->
          <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
              <span class="lang-en">{t.phoneWhatsapp.en}</span>
              <span class="lang-ar">{t.phoneWhatsapp.ar}</span>
            </span>
            <div class="mt-1 space-y-0.5 font-mono text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 ltr">
              <a href={`tel:${phonePrimary.replace(/\s+/g, '')}`} class="block hover:underline">{phonePrimary}</a>
              <a href={`tel:${phoneSecondary.replace(/\s+/g, '')}`} class="block text-slate-500 hover:underline">{phoneSecondary}</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Academic Profiles & Inquiries (5 cols) -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-200/90 bg-slate-50/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
        <h3 class="font-serif text-base font-bold text-slate-900 dark:text-white">
          <span class="lang-en">Scholarly Profiles & Inquiries</span>
          <span class="lang-ar">الملفات الأكاديمية والاستشارات</span>
        </h3>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          <span class="lang-en">{t.officeHoursNotice.en}</span>
          <span class="lang-ar">{t.officeHoursNotice.ar}</span>
        </p>

        <div class="mt-5 space-y-2.5">
          <a
            href={links.scholar}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
          >
            <span class="flex items-center gap-2 font-semibold">
              <svg class="h-4 w-4 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 100 14 7 7 0 000-14z"/>
              </svg>
              Google Scholar
            </span>
            <span class="text-slate-400 rtl:rotate-180">&rarr;</span>
          </a>

          <a
            href={links.orcid}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
          >
            <span class="flex items-center gap-2 font-semibold text-emerald-800 dark:text-emerald-400">
              <span class="font-bold">iD</span>
              ORCID
            </span>
            <span class="text-slate-400 rtl:rotate-180">&rarr;</span>
          </a>

          <a
            href={links.researchGate}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
          >
            <span class="flex items-center gap-2 font-serif font-bold text-teal-700 dark:text-teal-400">
              ResearchGate
            </span>
            <span class="text-slate-400 rtl:rotate-180">&rarr;</span>
          </a>

          <a
            href={links.semanticScholar}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
          >
            <span class="flex items-center gap-2 font-serif font-bold text-slate-800 dark:text-slate-200">
              Semantic Scholar
            </span>
            <span class="text-slate-400 rtl:rotate-180">&rarr;</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
