---
import { personalProfile } from '../data/profile';
import { uiTranslations } from '../data/translations';

const name = personalProfile?.name || { en: 'Prof. Dr. Rasha Abdulaziz Bin-Thalab', ar: 'أ.د. رشا عبدالعزيز بن ثعلب' };
const title = personalProfile?.title || { en: 'Professor of Computer Science & Information Systems', ar: 'أستاذ علوم الحاسوب ونظم المعلومات' };
const t = uiTranslations.nav;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/90 bg-white/95 backdrop-blur-md transition-colors dark:border-slate-800/90 dark:bg-slate-950/95 no-print">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    
    <!-- Academic Brand -->
    <a href="#top" class="group flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-academic-navy-900 font-serif font-bold text-white shadow-sm ring-1 ring-slate-900/10 transition-transform group-hover:scale-105 dark:bg-slate-800 dark:text-academic-gold-400 dark:ring-slate-700">
        RB
      </div>
      <div class="flex flex-col">
        <span class="font-serif text-base font-bold tracking-tight text-slate-900 group-hover:text-academic-navy-700 dark:text-white dark:group-hover:text-academic-gold-400">
          <span class="lang-en">{name.en}</span>
          <span class="lang-ar">{name.ar || name.en}</span>
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          <span class="lang-en">{title.en}</span>
          <span class="lang-ar">{title.ar || title.en}</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 text-xs sm:text-sm font-medium lg:flex">
      <a href="#about" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.about.en}</span>
        <span class="lang-ar">{t.about.ar}</span>
      </a>
      <a href="#research" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.research.en}</span>
        <span class="lang-ar">{t.research.ar}</span>
      </a>
      <a href="#quality" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.quality.en}</span>
        <span class="lang-ar">{t.quality.ar}</span>
      </a>
      <a href="#teaching" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.teaching.en}</span>
        <span class="lang-ar">{t.teaching.ar}</span>
      </a>
      <a href="#activities" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.activities.en}</span>
        <span class="lang-ar">{t.activities.ar}</span>
      </a>
      <a href="#projects" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.projects.en}</span>
        <span class="lang-ar">{t.projects.ar}</span>
      </a>
      <a href="#contact" class="rounded-md px-2.5 py-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
        <span class="lang-en">{t.contact.en}</span>
        <span class="lang-ar">{t.contact.ar}</span>
      </a>
    </nav>

    <!-- Controls: Language Switcher, Theme Toggle, CV Trigger -->
    <div class="flex items-center gap-2">
      <!-- Language Switcher -->
      <button
        id="lang-toggle-btn"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        title="Toggle Language / تبديل اللغة (English / العربية)"
        aria-label="Toggle language"
      >
        <svg class="h-3.5 w-3.5 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <span id="lang-label" class="font-bold">
          <span class="lang-en">العربية</span>
          <span class="lang-ar">English</span>
        </span>
      </button>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="rounded-lg border border-slate-200 bg-slate-50 p-2 text-slate-600 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
        title="Toggle Theme"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon-sun" class="hidden dark:block h-4 w-4 text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-moon" class="block dark:hidden h-4 w-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Print / CV Action -->
      <button
        type="button"
        onclick="window.print()"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-academic-navy-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-academic-navy-800 dark:bg-academic-gold-500 dark:text-slate-950 dark:hover:bg-academic-gold-400"
        title="Print Academic Profile or Export as PDF"
      >
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span class="lang-en">{t.cvPrint.en}</span>
        <span class="lang-ar">{t.cvPrint.ar}</span>
      </button>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden dark:text-slate-300 dark:hover:bg-slate-800"
        aria-label="Toggle mobile menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden border-b border-slate-200 bg-white px-4 py-3 lg:hidden dark:border-slate-800 dark:bg-slate-950">
    <div class="flex flex-col gap-1 text-sm font-medium">
      <a href="#about" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.about.en}</span>
        <span class="lang-ar">{t.about.ar}</span>
      </a>
      <a href="#research" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.research.en}</span>
        <span class="lang-ar">{t.research.ar}</span>
      </a>
      <a href="#quality" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.quality.en}</span>
        <span class="lang-ar">{t.quality.ar}</span>
      </a>
      <a href="#teaching" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.teaching.en}</span>
        <span class="lang-ar">{t.teaching.ar}</span>
      </a>
      <a href="#activities" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.activities.en}</span>
        <span class="lang-ar">{t.activities.ar}</span>
      </a>
      <a href="#projects" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.projects.en}</span>
        <span class="lang-ar">{t.projects.ar}</span>
      </a>
      <a href="#contact" class="mobile-nav-link rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
        <span class="lang-en">{t.contact.en}</span>
        <span class="lang-ar">{t.contact.ar}</span>
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg bg-academic-navy-900 py-2 text-xs font-semibold text-white dark:bg-academic-gold-500 dark:text-slate-950"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span class="lang-en">{t.cvPrint.en}</span>
        <span class="lang-ar">{t.cvPrint.ar}</span>
      </button>
    </div>
  </div>
</header>
