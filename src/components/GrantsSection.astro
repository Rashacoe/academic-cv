---
import { cvData } from '../data/cvData';
const { grants } = cvData;
---

<section id="grants" class="py-14 sm:py-20 bg-slate-100/50 border-b border-slate-200/80 dark:bg-academic-navy-950/40 dark:border-slate-800/80">
  <div class="mx-auto max-w-academic px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n-en="Sponsored Research & Grants" data-i18n-ar="المنح والمشاريع البحثية الممولة">
          Sponsored Research & Grants
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400" data-i18n-en="Competitive research awards from national foundations, industry consortia, and international agencies" data-i18n-ar="المنح التنافسية من الهيئات الوطنية، والشركاء الصناعيين، والمنظمات الدولية">
          Competitive research awards from national foundations, industry consortia, and international agencies
        </p>
      </div>
    </div>

    <!-- Grants Grid -->
    <div class="mt-8 space-y-4">
      {grants.map((grant) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            
            <div class="space-y-1">
              <!-- Status & Role Badges -->
              <div class="flex flex-wrap items-center gap-2">
                <span class={`rounded px-2 py-0.5 text-xs font-semibold ${grant.status === 'active' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'}`}>
                  {grant.status === 'active' ? '● Active Grant' : 'Completed'}
                </span>

                <span class="rounded bg-academic-navy-50 px-2 py-0.5 text-xs font-semibold text-academic-navy-900 dark:bg-academic-navy-900 dark:text-academic-gold-400" data-i18n-en={grant.role.en} data-i18n-ar={grant.role.ar}>
                  {grant.role.en}
                </span>

                <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                  #{grant.grantNumber}
                </span>
              </div>

              <!-- Grant Title -->
              <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white" data-i18n-en={grant.title.en} data-i18n-ar={grant.title.ar}>
                {grant.title.en}
              </h3>

              <!-- Agency & Period -->
              <p class="text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400">
                <span data-i18n-en={grant.agency.en} data-i18n-ar={grant.agency.ar}>{grant.agency.en}</span>
                <span class="mx-2 text-slate-300 dark:text-slate-600">•</span>
                <span>{grant.period}</span>
              </p>
            </div>

            <!-- Award Amount Badge -->
            <div class="inline-flex shrink-0 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-center text-sm font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300">
              {grant.amount}
            </div>
          </div>

          <!-- Description -->
          <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300" data-i18n-en={grant.description.en} data-i18n-ar={grant.description.ar}>
            {grant.description.en}
          </p>

          <!-- Collaborators (if any) -->
          {grant.collaborators && (
            <div class="mt-3 flex flex-wrap items-center gap-1.5 pt-3 border-t border-slate-100 text-xs text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
              <span class="font-medium" data-i18n-en="Collaborators:" data-i18n-ar="الجهات المشاركة:">Collaborators:</span>
              {grant.collaborators.map((collab) => (
                <span class="rounded bg-slate-100 px-2 py-0.5 dark:bg-slate-800 dark:text-slate-300">
                  {collab}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
