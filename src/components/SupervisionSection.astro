---
import { cvData } from '../data/cvData';
const { supervision } = cvData;
---

<section id="supervision" class="py-14 sm:py-20 bg-slate-100/50 border-b border-slate-200/80 dark:bg-academic-navy-950/40 dark:border-slate-800/80">
  <div class="mx-auto max-w-academic px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-academic-navy-900 dark:text-academic-gold-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </span>
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n-en="Doctoral Supervision & Alumni Placements" data-i18n-ar="الإشراف على الدكتوراه ومواقع الخريجين">
          Doctoral Supervision & Alumni Placements
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400" data-i18n-en="Ph.D. advisees, postdoctoral fellows, dissertation topics, and their initial academic & industry appointments" data-i18n-ar="باحثو الدكتوراه وما بعد الدكتوراه، ومواضيع أطروحاتهم، ومواقع تعيينهم الأكاديمية والمهنية">
          Ph.D. advisees, postdoctoral fellows, dissertation topics, and their initial academic & industry appointments
        </p>
      </div>
    </div>

    <!-- Supervision Grid -->
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {supervision.map((student) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-serif text-base font-bold text-slate-900 dark:text-white">
                {student.name}
              </h3>
              <span class="inline-block mt-0.5 rounded bg-academic-navy-50 px-2 py-0.5 text-xs font-semibold text-academic-navy-800 dark:bg-academic-navy-950 dark:text-academic-gold-400">
                {student.role} ({student.year})
              </span>
            </div>

            <!-- Graduation Cap Icon -->
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
          </div>

          <!-- Dissertation -->
          <p class="mt-3 text-xs text-slate-600 dark:text-slate-300">
            <strong class="font-semibold text-slate-800 dark:text-slate-200" data-i18n-en="Dissertation: " data-i18n-ar="عنوان الأطروحة: ">Dissertation: </strong>
            <span class="italic" data-i18n-en={`"${student.dissertation.en}"`} data-i18n-ar={`"${student.dissertation.ar}"`}>"{student.dissertation.en}"</span>
          </p>

          <!-- Placement Badge -->
          <div class="mt-3 flex items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-xs font-medium text-slate-700 dark:border-slate-800 dark:bg-slate-900/90 dark:text-slate-300">
            <svg class="h-4 w-4 shrink-0 text-academic-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <span class="font-bold text-slate-900 dark:text-white" data-i18n-en="Placement: " data-i18n-ar="التعيين: ">Placement: </span>
              <span data-i18n-en={student.placement.en} data-i18n-ar={student.placement.ar}>{student.placement.en}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
