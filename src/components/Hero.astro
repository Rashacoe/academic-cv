---
import { personalProfile } from '../data/profile';
import { uiTranslations } from '../data/translations';

const name = personalProfile?.name || { en: 'Prof. Dr. Rasha Abdulaziz Bin-Thalab', ar: 'أ.د. رشا عبدالعزيز بن ثعلب' };
const title = personalProfile?.title || { en: 'Professor of Computer Science & Information Systems', ar: 'أستاذ علوم الحاسوب ونظم المعلومات' };
const department = personalProfile?.department || { en: 'Department of Computer Engineering', ar: 'قسم هندسة الحاسوب' };
const faculty = personalProfile?.faculty || { en: 'Faculty of Engineering & Petroleum', ar: 'كلية الهندسة والبترول' };
const institution = personalProfile?.institution || { en: 'Hadhramout University', ar: 'جامعة حضرموت' };
const location = personalProfile?.location || { en: 'Mukalla, Hadhramout, Yemen', ar: 'المكلا، حضرموت، اليمن' };
const email = personalProfile?.email || 'r.binthalab@hu.edu.ye';
const executiveSummary = personalProfile?.executiveSummary || { en: '', ar: '' };
const professionalIdentities = personalProfile?.professionalIdentities || [];
const links = personalProfile?.links || {
  scholar: 'https://scholar.google.com',
  orcid: 'https://orcid.org',
  researchGate: 'https://www.researchgate.net',
  semanticScholar: 'https://www.semanticscholar.org',
};
const t = uiTranslations.hero;
---

<section id="top" class="relative overflow-hidden border-b border-slate-200/80 bg-gradient-to-b from-slate-100/80 via-white to-slate-50/60 py-12 sm:py-16 lg:py-20 dark:border-slate-800/80 dark:from-slate-950 dark:via-slate-900/60 dark:to-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      
      <!-- Left / Profile Identity Column -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left rtl:lg:text-right flex-1">
        
        <!-- Institutional Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-academic-navy-200 bg-academic-navy-50/90 px-3.5 py-1 text-xs font-semibold text-academic-navy-900 dark:border-academic-navy-800 dark:bg-academic-navy-950/70 dark:text-academic-gold-400">
          <svg class="h-3.5 w-3.5 text-academic-gold-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
          </svg>
          <span>
            <span class="lang-en">{institution.en}</span>
            <span class="lang-ar">{institution.ar || institution.en}</span>
          </span>
        </div>

        <!-- Name -->
        <h1 class="mt-4 font-serif text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
          <span class="lang-en">{name.en}</span>
          <span class="lang-ar">{name.ar || name.en}</span>
        </h1>

        <!-- Academic Rank & Affiliation -->
        <div class="mt-2.5 space-y-1">
          <p class="font-serif text-lg sm:text-xl font-semibold text-academic-navy-700 dark:text-academic-gold-400">
            <span class="lang-en">{title.en}</span>
            <span class="lang-ar">{title.ar || title.en}</span>
          </p>
          <p class="text-sm sm:text-base font-medium text-slate-600 dark:text-slate-300">
            <span class="lang-en">{department.en}, {faculty.en}</span>
            <span class="lang-ar">{department.ar || department.en}، {faculty.ar || faculty.en}</span>
          </p>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            📍 <span class="lang-en">{location.en}</span><span class="lang-ar">{location.ar || location.en}</span>
          </p>
        </div>

        <!-- Executive Introduction (Verbatim from Approved CV) -->
        <div class="mt-5 max-w-3xl rounded-xl border-l-4 border-academic-navy-700 bg-white/80 p-4 sm:p-5 text-sm sm:text-base leading-relaxed text-slate-700 shadow-sm dark:border-academic-gold-400 dark:bg-slate-900/60 dark:text-slate-200 rtl:border-l-0 rtl:border-r-4">
          <p class="lang-en">
            {executiveSummary.en}
          </p>
          <p class="lang-ar">
            {executiveSummary.ar || executiveSummary.en}
          </p>
        </div>

        <!-- Call to Action Buttons -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href="#about"
            class="inline-flex items-center gap-2 rounded-lg bg-academic-navy-900 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-md transition hover:bg-academic-navy-800 active:scale-95 dark:bg-academic-gold-500 dark:text-slate-950 dark:hover:bg-academic-gold-400"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="lang-en">{t.viewProfile.en}</span>
            <span class="lang-ar">{t.viewProfile.ar}</span>
          </a>

          <a
            href="#research"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <svg class="h-4 w-4 text-academic-navy-700 dark:text-academic-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="lang-en">{t.viewPublications.en}</span>
            <span class="lang-ar">{t.viewPublications.ar}</span>
          </a>

          <button
            type="button"
            onclick="window.print()"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs sm:text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="lang-en">{t.downloadCv.en}</span>
            <span class="lang-ar">{t.downloadCv.ar}</span>
          </button>
        </div>

        <!-- Academic Profile Badges -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 lg:justify-start">
          <a
            href={links.scholar}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
          >
            <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 100 14 7 7 0 000-14z"/>
            </svg>
            <span class="lang-en">{t.scholar.en}</span>
            <span class="lang-ar">{t.scholar.ar}</span>
          </a>

          <a
            href={links.orcid}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-emerald-200 bg-emerald-50/60 px-2.5 py-1 text-xs font-medium text-emerald-800 shadow-sm transition hover:bg-emerald-100/60 dark:border-emerald-900/50 dark:bg-emerald-950/40 dark:text-emerald-300"
          >
            <span class="font-bold text-emerald-600 dark:text-emerald-400">iD</span>
            <span class="lang-en">{t.orcid.en}</span>
            <span class="lang-ar">{t.orcid.ar}</span>
          </a>

          <a
            href={links.researchGate}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-teal-200 bg-teal-50/60 px-2.5 py-1 text-xs font-medium text-teal-800 shadow-sm transition hover:bg-teal-100/60 dark:border-teal-900/50 dark:bg-teal-950/40 dark:text-teal-300"
          >
            <span class="font-serif font-bold text-teal-700 dark:text-teal-400">RG</span>
            <span class="lang-en">{t.researchGate.en}</span>
            <span class="lang-ar">{t.researchGate.ar}</span>
          </a>

          <a
            href={links.semanticScholar}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
          >
            <span class="font-serif font-bold text-slate-800 dark:text-slate-200">S2</span>
            <span class="lang-en">{t.semanticScholar.en}</span>
            <span class="lang-ar">{t.semanticScholar.ar}</span>
          </a>

          <a
            href={`mailto:${email}`}
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-academic-navy-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-academic-gold-400"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{email}</span>
          </a>
        </div>

      </div>

      <!-- Right / 3 Core Professional Identities Cards -->
      <div class="w-full lg:max-w-md space-y-3.5">
        <div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-400">
          <span class="lang-en">{t.professionalIdentities.en}</span>
          <span class="lang-ar">{t.professionalIdentities.ar}</span>
        </div>

        {professionalIdentities.map((identity) => (
          <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm transition hover:border-academic-navy-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/70">
            <div class="flex items-start gap-3.5">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-academic-navy-50 text-academic-navy-800 dark:bg-slate-800 dark:text-academic-gold-400">
                {identity.icon === 'microscope' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                  </svg>
                )}
                {identity.icon === 'shield-check' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {identity.icon === 'academic-cap' && (
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  </svg>
                )}
              </div>
              <div>
                <h2 class="font-serif text-base font-bold text-slate-900 dark:text-white">
                  <span class="lang-en">{identity.title.en}</span>
                  <span class="lang-ar">{identity.title.ar || identity.title.en}</span>
                </h2>
                <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                  <span class="lang-en">{identity.description.en}</span>
                  <span class="lang-ar">{identity.description.ar || identity.description.en}</span>
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
