---
import { cvData } from '../data/cvData';
const { publications } = cvData;
---

<section id="publications" class="py-14 sm:py-20 border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="mx-auto max-w-academic px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-academic-navy-100 text-academic-navy-900 dark:bg-academic-navy-900 dark:text-academic-gold-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </span>
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n-en="Peer-Reviewed Publications" data-i18n-ar="الأبحاث والمنشورات العلمية المحكّمة">
            Peer-Reviewed Publications
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400" data-i18n-en="Top-tier journals (AIS Basket of 8), refereed proceedings, and books" data-i18n-ar="مجلات النخبة (سلة AIS الثمانية)، وأعمال المؤتمرات، والكتب الأكاديمية">
            Top-tier journals (AIS Basket of 8), refereed proceedings, and books
          </p>
        </div>
      </div>

      <!-- Quick Metrics Pill -->
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <span class="rounded bg-academic-navy-50 px-2 py-1 text-academic-navy-900 dark:bg-academic-navy-900/60 dark:text-academic-gold-400">
          {publications.length} Featured Works
        </span>
      </div>
    </div>

    <!-- Filter Bar & Live Search -->
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <!-- Category Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800">
        <button
          type="button"
          data-pub-filter="all"
          class="pub-tab-btn active-tab rounded-lg px-3 py-1.5 text-xs font-semibold transition"
          data-i18n-en="All Works"
          data-i18n-ar="جميع الأعمال"
        >
          All Works
        </button>
        <button
          type="button"
          data-pub-filter="journal"
          class="pub-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition"
          data-i18n-en="Journal Articles (MISQ / ISR)"
          data-i18n-ar="المجلات المحكمة"
        >
          Journal Articles (MISQ / ISR)
        </button>
        <button
          type="button"
          data-pub-filter="conference"
          class="pub-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition"
          data-i18n-en="Conferences (ICIS)"
          data-i18n-ar="المؤتمرات (ICIS)"
        >
          Conferences (ICIS)
        </button>
        <button
          type="button"
          data-pub-filter="book"
          class="pub-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition"
          data-i18n-en="Books & Chapters"
          data-i18n-ar="الكتب وفصولها"
        >
          Books & Chapters
        </button>
      </div>

      <!-- Live Search Input -->
      <div class="relative min-w-[240px] sm:w-72">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 rtl:left-auto rtl:right-0 rtl:pl-0 rtl:pr-3">
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="pub-search-input"
          type="search"
          placeholder="Search by title, author, keyword..."
          class="w-full rounded-xl border border-slate-200 bg-white py-1.5 pl-9 pr-3 text-xs placeholder-slate-400 focus:border-academic-navy-500 focus:outline-none focus:ring-1 focus:ring-academic-navy-500 dark:border-slate-800 dark:bg-slate-900 dark:text-white rtl:pl-3 rtl:pr-9"
        />
      </div>
    </div>

    <!-- Publications List -->
    <div id="publications-container" class="mt-6 space-y-4">
      {publications.map((pub) => (
        <article
          class="publication-item group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-slate-700"
          data-type={pub.type}
          data-title-en={pub.title.en.toLowerCase()}
          data-title-ar={pub.title.ar.toLowerCase()}
          data-authors={pub.authors.join(' ').toLowerCase()}
          data-venue={pub.venue.toLowerCase()}
          data-tags={pub.tags.join(' ').toLowerCase()}
          data-year={pub.year}
        >
          <div class="flex flex-col gap-2">
            <!-- Top Badges & Year -->
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded bg-academic-navy-900 px-2 py-0.5 text-xs font-bold text-white dark:bg-academic-navy-700">
                  {pub.venueShort}
                </span>

                {pub.tier && (
                  <span class="rounded border border-academic-gold-200 bg-academic-gold-50 px-2 py-0.5 text-xs font-semibold text-academic-gold-800 dark:border-academic-gold-900/50 dark:bg-academic-gold-950/40 dark:text-academic-gold-300">
                    {pub.tier}
                  </span>
                )}

                {pub.award && (
                  <span class="inline-flex items-center gap-1 rounded bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span data-i18n-en={pub.award.en} data-i18n-ar={pub.award.ar}>{pub.award.en}</span>
                  </span>
                )}
              </div>

              <span class="font-mono text-xs font-semibold text-slate-500 dark:text-slate-400">
                {pub.year}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-serif text-lg font-bold text-slate-900 group-hover:text-academic-navy-700 dark:text-white dark:group-hover:text-academic-gold-400" data-i18n-en={pub.title.en} data-i18n-ar={pub.title.ar}>
              {pub.title.en}
            </h3>

            <!-- Authors List with Professor Highlight -->
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              {pub.authors.map((author, index) => (
                <span>
                  {author.includes('Al-Mansoor') ? (
                    <strong class="font-semibold text-academic-navy-900 underline decoration-academic-gold-500 decoration-2 dark:text-white">
                      {author}
                    </strong>
                  ) : (
                    author
                  )}
                  {index < pub.authors.length - 1 ? ', ' : ''}
                </span>
              ))}
            </p>

            <!-- Venue Details & Pages -->
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span class="italic font-medium text-slate-700 dark:text-slate-300">{pub.venue}</span>
              {pub.volume && <span>, Vol. {pub.volume}</span>}
              {pub.issue && <span>({pub.issue})</span>}
              {pub.pages && <span>, pp. {pub.pages}</span>}
              {pub.doi && <span class="font-mono ml-2">DOI: {pub.doi}</span>}
            </p>

            <!-- Abstract Dropdown / Expandable Text -->
            <details class="group/abs mt-2 text-xs text-slate-600 dark:text-slate-400">
              <summary class="cursor-pointer font-medium text-academic-navy-600 hover:text-academic-navy-800 dark:text-academic-gold-400 dark:hover:text-academic-gold-300">
                <span data-i18n-en="Show Abstract" data-i18n-ar="عرض الملخص">Show Abstract</span>
              </summary>
              <p class="mt-2 rounded-lg bg-slate-50 p-3 leading-relaxed border border-slate-100 dark:bg-slate-900/80 dark:border-slate-800" data-i18n-en={pub.abstract.en} data-i18n-ar={pub.abstract.ar}>
                {pub.abstract.en}
              </p>
            </details>

            <!-- Bottom Actions: DOI, PDF, BibTeX -->
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3 dark:border-slate-800/80">
              <!-- Tags -->
              <div class="flex flex-wrap gap-1">
                {pub.tags.map((tag) => (
                  <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                    #{tag}
                  </span>
                ))}
              </div>

              <!-- Action Links -->
              <div class="flex items-center gap-2">
                {pub.doi && (
                  <a
                    href={`https://doi.org/${pub.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                  >
                    <svg class="h-3 w-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span>DOI</span>
                  </a>
                )}

                {pub.pdfUrl && (
                  <a
                    href={pub.pdfUrl}
                    class="inline-flex items-center gap-1 rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                  >
                    <svg class="h-3 w-3 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>PDF</span>
                  </a>
                )}

                <!-- BibTeX Copy Button -->
                <button
                  type="button"
                  class="bibtex-copy-btn inline-flex items-center gap-1 rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
                  data-bibtex={pub.bibtex}
                >
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span>BibTeX</span>
                </button>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty search feedback -->
    <div id="no-pub-results" class="hidden rounded-2xl border border-dashed border-slate-300 py-12 text-center dark:border-slate-800">
      <p class="text-sm text-slate-500 dark:text-slate-400" data-i18n-en="No publications match your search criteria." data-i18n-ar="لا توجد أبحاث تطابق معايير البحث الحالية.">
        No publications match your search criteria.
      </p>
    </div>
  </div>
</section>

<!-- BibTeX Toast / Notification -->
<div id="bibtex-toast" class="fixed bottom-6 right-6 z-50 hidden rounded-xl border border-slate-200 bg-slate-900 px-4 py-3 text-xs font-medium text-white shadow-2xl transition-opacity duration-300 dark:border-slate-700 dark:bg-white dark:text-slate-950">
  <div class="flex items-center gap-2">
    <svg class="h-4 w-4 text-emerald-400 dark:text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-text" data-i18n-en="BibTeX citation copied to clipboard!" data-i18n-ar="تم نسخ استشهاد BibTeX للحافظة!">BibTeX citation copied to clipboard!</span>
  </div>
</div>
